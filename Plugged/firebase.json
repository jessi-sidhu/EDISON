{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "plugged-hackathon",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "backend/**",
      "functions/**",
      "src/**",
      "out/**",
      "package.json",
      "package-lock.json",
      "tsconfig.json",
      "vitest.config.mjs",
      "test/**",
      "docs/**",
      "*.png",
      "*.md"
    ]
  }
}
