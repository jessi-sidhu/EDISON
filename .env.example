# Variable names only — never put real values in this file.
# The app reads Plugged/backend/.env (create it yourself; agents are blocked
# from reading or writing .env files). Copy the lines you need and fill them in.

# Which AI answers the tutor: deepseek, gemini, claude (local Claude Code CLI),
# or fixture (replays recorded answers, no key, no cost).
AI_PROVIDER=

# DeepSeek (AI_PROVIDER=deepseek). Paid: top up at platform.deepseek.com first.
DEEPSEEK_API_KEY=
# Optional, default deepseek-flash
DEEPSEEK_MODEL=
# Optional, default 60000: one deadline (ms) for a whole ask, then /api/ask answers 504
DEEPSEEK_TIMEOUT_MS=
# Optional, default deepseek-v4-pro; empty turns it off. Asked once when the
# primary model times out, answers 5xx or can't be reached (never on a 4xx)
DEEPSEEK_FALLBACK_MODEL=
# Optional, default 25000: how long (ms) one primary request may take before
# the ask switches to the fallback model
DEEPSEEK_PRIMARY_TIMEOUT_MS=

# Gemini (AI_PROVIDER=gemini). Free key at aistudio.google.com/apikey.
GEMINI_API_KEY=
# Optional, default gemini-flash-latest
GEMINI_MODEL=

# Photo → circuit (/api/photo). Readers tried in order, default gemini,deepseek
# (deepseek is deepseek-flash only: no fallback model, it has no vision), or
# fixture (replays recorded Readings only, no key, no cost).
PHOTO_PROVIDERS=
# The Gemini model for photos; uses GEMINI_API_KEY above. Pin a version,
# never a -latest alias
PHOTO_GEMINI_MODEL=
# Optional, default 45000: one deadline (ms) for a whole photo, then /api/photo answers 504
PHOTO_TIMEOUT_MS=
# Set to 1 to save each Reading to Plugged/test/fixtures/photo/<key>.json for fixture replay
PHOTO_RECORD=

# Server port, default 5001
PORT=
# Set to 1 only behind exactly one proxy (e.g. Render) so rate limits are per visitor
TRUST_PROXY=
